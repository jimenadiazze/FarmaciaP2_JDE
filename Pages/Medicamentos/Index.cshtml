@page
@model Farmacia.Pages.Medicamentos.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Medicamento[0].Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Medicamento[0].Laboratorio)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Medicamento[0].Precio)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Medicamento[0].Stock)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Medicamento[0].Categoria)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Medicamento[0].FechaCaducidad)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Medicamento) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Laboratorio)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Precio)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Stock)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Categoria)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FechaCaducidad)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
